# ---------------------------------------------------------------------
# Copiez ce fichier vers .env.local  ( cp .env.example .env.local )
# ---------------------------------------------------------------------

# Mot de passe du back-office (page /admin). À changer avant la mise en ligne.
ADMIN_PASSWORD=marilyse

# Clé de signature du cookie de session. En prod : une chaîne aléatoire longue.
# Générer :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=chaine-aleatoire-a-remplacer-avant-la-mise-en-ligne

# ---------------------------------------------------------------------
# Supabase — laissez vide en local : l'app bascule alors sur le mode démo
# (data/articles.json + /public/uploads). Renseignez les deux pour passer
# en base réelle, sans toucher au code.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Ouverture de la page d'accueil
# Déposez la vidéo dans public/media/ puis décommentez la ligne ci-dessous.
# Tant qu'elle est vide, l'image fixe (poster) est utilisée.
# ---------------------------------------------------------------------
# NEXT_PUBLIC_HERO_VIDEO=/media/hero.mp4
# NEXT_PUBLIC_HERO_IMAGE=/media/ouverture.jpg

# Adresse publique du site, une fois en ligne. Sert aux images de partage
# et au plan du site.  Exemple : https://aujourdelamode.fr
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------
# Traduction assistée (facultatif)
# Sans cette clé, le bouton « Traduire » de l'admin est désactivé et la
# traduction se fait à la main. Rien d'autre ne change.
# Clé : https://console.anthropic.com
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# Limiteur de débit partagé (facultatif, fortement conseillé en production)
# Sans ces deux valeurs, le compteur d'essais de connexion et d'inscription
# reste en mémoire locale — sans effet réel sur Vercel entre plusieurs
# instances serverless. Compte gratuit : https://console.upstash.com
# ---------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
